root = true

[*.{kt,kts}]
# ktlint (./gradlew ktlintCheck, ./gradlew ktlintFormat) checks hygiene, not layout: the codebase
# uses a dense layout (several statements on a line, long argument lists, aligned comments) that
# the wrapping and spacing rules below would rewrite in every file. They stay off so that adopting
# ktlint does not reformat the project; the remaining standard rules apply to all code.
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable

# Layout: wrapping and line breaks.
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_multiline-loop = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_indent = disabled
ktlint_standard_no-semi = disabled

# Layout: spacing and blank lines.
ktlint_standard_annotation = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_colon-spacing = disabled
ktlint_standard_comma-spacing = disabled
ktlint_standard_curly-spacing = disabled
ktlint_standard_function-start-of-body-spacing = disabled
ktlint_standard_keyword-spacing = disabled
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_op-spacing = disabled
ktlint_standard_paren-spacing = disabled
ktlint_standard_parameter-list-spacing = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# Conventions the project does not follow: wildcard imports, import order, file names after the
# single class, constants in screaming case, expression bodies and mixed && / || conditions.
ktlint_standard_filename = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_import-ordering = disabled
ktlint_standard_mixed-condition-operators = disabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_property-naming = disabled
