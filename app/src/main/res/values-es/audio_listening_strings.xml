    <string name="audio_listening_wired">Auriculares con cable o USB</string>
    <string name="audio_listening_bluetooth">Salida Bluetooth</string>
    <string name="audio_listening_speaker">Altavoz integrado (selección explícita)</string>
    <string name="audio_listening_speaker_warning">El altavoz puede realimentar el micrófono y quedar grabado acústicamente. Bajá el volumen de escucha antes de conectar. No se cambia al altavoz automáticamente.</string>
    <string name="audio_listening_latency">La latencia de escucha no está medida; Bluetooth puede introducir una demora considerable. La salida elegida es una solicitud hasta que la ruta se confirme.</string>
