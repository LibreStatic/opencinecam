<resources>
    <string name="audio_listening_title">Salida de escucha</string>
    <string name="audio_listening_help">Sólo reproducción: no modifica la ganancia del micrófono ni las muestras grabadas. Activar, importar un preset o reabrir la app no conecta audio; pulsá Conectar explícitamente. Los medidores solos no confirman escucha.</string>
    <string name="audio_listening_enable">Habilitar preferencia de escucha</string>
