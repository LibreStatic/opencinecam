    <string name="onb_continue">Continue</string>
    <string name="onb_perm_camera">Camera</string>
    <string name="onb_perm_camera_body">Needed for the viewfinder, photos and video.</string>
    <string name="onb_perm_mic">Microphone</string>
    <string name="onb_perm_mic_body">Records sound for your clips and drives the audio meters. Without it, clips are silent.</string>
    <string name="onb_perm_location">Location</string>
    <string name="onb_perm_location_body">Only used if you turn on geotagging, to write where a clip was shot into its metadata.</string>
    <string name="onb_perm_notifications">Notifications</string>
    <string name="onb_perm_notifications_body">Shows a notice while recording, so a take keeps going if you leave the app.</string>
    <string name="onb_camera_needed">Allow camera access to continue.</string>
