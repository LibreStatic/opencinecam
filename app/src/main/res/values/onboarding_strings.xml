    <string name="onb_welcome_title">OpenCineCam</string>
    <string name="onb_welcome_body">A free, open-source cinema camera for your phone. Manual exposure, LOG, LUTs, scopes and pro audio, all on-device: no account, no tracking.</string>
    <string name="onb_features_label">What you can do</string>
    <string name="onb_features_title">Shoot like a cinema camera</string>
    <string name="onb_feature_manual">Full manual control</string>
    <string name="onb_feature_manual_body">ISO, shutter, white balance and focus</string>
    <string name="onb_feature_log">LOG + LUT monitoring</string>
    <string name="onb_feature_log_body">Grade later, preview the look now</string>
    <string name="onb_feature_scopes">Zebras, peaking and scopes</string>
    <string name="onb_feature_scopes_body">Nail exposure and focus</string>
    <string name="onb_feature_audio">Pro audio sidecars</string>
    <string name="onb_feature_audio_body">WAV/FLAC, meters and gain</string>
    <string name="onb_feature_timecode">Timecode and slates</string>
    <string name="onb_feature_timecode_body">Ready for the edit bay</string>
    <string name="onb_tour_label">Quick tour</string>
    <string name="onb_tour_title">Your viewfinder</string>
    <string name="onb_tour_body">Tap a highlight to learn what it does.</string>
    <string name="onb_tour_status">Timecode and storage</string>
    <string name="onb_tour_status_body">Running timecode, recording format and the space left on your device.</string>
    <string name="onb_tour_rail">Quick rail</string>
    <string name="onb_tour_rail_body">Tap ISO, shutter, white balance or focus and swipe to change it without opening menus.</string>
    <string name="onb_tour_record">Record</string>
    <string name="onb_tour_record_body">Starts and stops a take. It only turns red while you are really recording.</string>
    <string name="onb_permissions_label">Permissions</string>
    <string name="onb_permissions_title">What we need and why</string>
    <string name="onb_permissions_body">Everything stays on your device. You can change any of these later in the system settings.</string>
    <string name="onb_required">Required</string>
    <string name="onb_optional">Optional</string>
