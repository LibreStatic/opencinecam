<resources>
    <!--
      Launches that do not come straight from a home-screen icon (launcher search, other apps) get
      an icon-less, solid-colour splash by default; the logo must always be there, both as the
      launch animation and for the hand-off into the first-run intro. Theme.OpenCineCam.Starting.You
      inherits this through its name.
    -->
    <style name="Theme.OpenCineCam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_cine</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenCineCam</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
