    <target android:name="arc_grey">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="520" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="260" android:valueFrom="0" android:valueTo="1" />
