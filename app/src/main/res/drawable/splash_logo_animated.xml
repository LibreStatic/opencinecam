    <target android:name="light">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="140" android:propertyName="scaleX" android:startOffset="700" android:valueFrom="0" android:valueTo="1.35" />
                <objectAnimator android:duration="140" android:propertyName="scaleY" android:startOffset="700" android:valueFrom="0" android:valueTo="1.35" />
