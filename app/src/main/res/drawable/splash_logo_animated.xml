                <objectAnimator android:duration="290" android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blade5">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="290" android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" />
                <objectAnimator android:duration="290" android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="1" />
