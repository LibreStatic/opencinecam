    <string name="onb_features_title">Drehen wie mit einer Kinokamera</string>
    <string name="onb_feature_manual">Volle manuelle Kontrolle</string>
    <string name="onb_feature_manual_body">ISO, Verschlusszeit, Weißabgleich und Fokus</string>
    <string name="onb_feature_log">LOG- + LUT-Monitoring</string>
    <string name="onb_feature_log_body">Später graden, den Look schon jetzt ansehen</string>
