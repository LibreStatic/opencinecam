<resources>
    <string name="audio_listening_title">Mithörausgang</string>
    <string name="audio_listening_help">Nur Wiedergabe: Mikrofonverstärkung und aufgenommene Samples bleiben unverändert. Aktivieren, Importieren eines Presets oder erneutes Öffnen der App verbindet kein Audio; tippe ausdrücklich auf Verbinden. Pegelanzeigen allein bestätigen die Wiedergabe nicht.</string>
    <string name="audio_listening_enable">Mithör-Einstellung aktivieren</string>
    <string name="audio_listening_volume">Angeforderte Mithörlautstärke: %1$d%%</string>
