    <!-- OCC-PLAN-071: the RAW video qualification prompt, step and onboarding question. -->
    <string name="raw_qualification_prompt_title">RAW-Video qualifizieren?</string>
    <string name="raw_qualification_prompt_body">Dabei werden Speicher und Kamera in jeder RAW-Konfiguration gemessen, damit RAW-Video nur anbietet, was dieses Gerät ohne Bildverlust durchhält.</string>
