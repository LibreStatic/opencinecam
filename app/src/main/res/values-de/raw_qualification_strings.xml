    <string name="raw_qualification_previous_failure">Die letzte Qualifizierung hat keine Konfiguration gefunden, die dieses Gerät durchhält.</string>
    <string name="raw_qualification_prompt_start">Jetzt qualifizieren</string>
    <string name="raw_qualification_prompt_later">Nicht jetzt</string>
    <string name="raw_qualification_prompt_dismiss">OK</string>

