{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "Advertised",
        "Candidate",
        "SessionCreated",
        "FirstFrameReceived",
        "Recorded",
        "FileVerified",
        "Sustained",
        "EmpiricallyVerified",
        "Failed",
        "Certified"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "observedAt"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "stale",
            "notRun"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "knownValue": {
      "type": "object",
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unsupported",
            "known"
          ]
        },
        "value": {},
        "unit": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://opencinecam.org/schema/device-profile.schema.json",
  "title": "Device Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "profileId",
    "createdAt",
    "scope",
    "validity",
    "configurations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "buildFingerprint",
        "cameraId"
      ]
    },
    "validity": {
      "type": "object",
      "required": [
        "protocolVersion",
        "characteristicsDigest"
      ]
    },
    "configurations": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
