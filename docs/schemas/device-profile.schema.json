{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "Advertised",
        "Candidate",
        "SessionCreated",
        "FirstFrameReceived",
        "Recorded",
        "FileVerified",
        "Sustained",
        "EmpiricallyVerified",
        "Failed",
        "Certified"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "observedAt"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "stale",
            "notRun"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "knownValue": {
      "type": "object",
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unsupported",
            "known"
          ]
        },
        "value": {},
        "unit": {
          "type": "string"
        }
      }
    },
    "effectId": {
      "description": "Closed quirk effect vocabulary; an id this build does not know is ignored with a warning, never applied.",
      "type": "string",
      "enum": [
        "high-speed-prefer-physical-camera",
        "moto-high-speed-session-keys"
      ]
    },
    "profileQuirk": {
      "type": "object",
      "required": [
        "quirkId",
        "effect",
        "enabled"
      ],
      "properties": {
        "quirkId": {
          "type": "string",
          "pattern": "^OCC-QUIRK-[0-9]{4}$"
        },
        "effect": {
          "$ref": "#/$defs/effectId"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$id": "https://opencinecam.org/schema/device-profile.schema.json",
  "title": "Device Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "profileId",
    "createdAt",
    "source",
    "trust",
    "scope",
    "validity",
    "configurations",
    "quirks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "trust": {
      "enum": [
        "BUNDLED_TRUSTED",
        "IMPORTED_UNTRUSTED",
        "USER_OVERRIDE"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "device",
        "buildFingerprint",
        "cameraId"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1,
          "description": "Device codename (Build.DEVICE, ro.product.device), e.g. blanc. Never a manufacturer, never a wildcard."
        },
        "buildFingerprint": {
          "type": "string",
          "minLength": 1,
          "description": "The build the profile was verified on. Recorded, not matched."
        },
        "cameraId": {
          "type": "string",
          "minLength": 1
        },
        "physicalCameraId": {
          "type": "string",
          "minLength": 1,
          "description": "Narrows the match only when present."
        },
        "codecName": {
          "type": "string",
          "minLength": 1,
          "description": "Narrows the match only when present."
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "protocolVersion"
      ],
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "characteristicsDigest": {
          "type": "string",
          "minLength": 1,
          "description": "Recorded evidence when known. Not matched."
        }
      }
    },
    "configurations": {
      "type": "array"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "keyId",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "quirks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileQuirk"
      }
    }
  },
  "additionalProperties": true,
  "description": "A device profile is scoped to one device model (the codename, Build.DEVICE) and one camera. The build fingerprint is recorded as the build the profile was verified on; a different running fingerprint keeps the profile active with a 'not verified on this build' warning. A manufacturer-wide scope is not a profile."
}
