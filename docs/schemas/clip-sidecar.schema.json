{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "motionSensor": {
      "type": "object",
      "required": [
        "present",
        "nominalMaxHz",
        "measuredHz",
        "samples"
      ],
      "properties": {
        "present": {
          "description": "Whether the device has the sensor and the take read it.",
          "type": "boolean"
        },
        "nominalMaxHz": {
          "description": "The fastest rate the sensor declares (1 / minDelay); null when unknown or absent.",
          "type": [
            "number",
            "null"
          ]
        },
        "measuredHz": {
          "description": "The rate measured on the sensor clock over the take; null with fewer than two samples.",
          "type": [
            "number",
            "null"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "Advertised",
        "Candidate",
        "SessionCreated",
        "FirstFrameReceived",
        "Recorded",
        "FileVerified",
        "Sustained",
        "EmpiricallyVerified",
        "Failed",
        "Certified"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "observedAt"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "stale",
            "notRun"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "sampledRange": {
      "description": "A value sampled through the take: the first and last readings and the extremes in between.",
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "cameraSettings": {
      "type": "object",
      "properties": {
        "cameraId": {
          "type": "string"
        },
        "focalLengthMm": {
          "type": "number"
        },
        "focalLength35mm": {
          "description": "35 mm equivalent, inferred from the sensor size.",
          "type": "number"
        },
        "aperture": {
          "description": "f-number.",
          "type": "number"
        },
        "exposureMode": {
          "description": "ExposureMode names: AUTO, MANUAL, ISO_PRIORITY or SHUTTER_PRIORITY.",
          "type": "object",
          "properties": {
            "requested": {
              "type": "string"
            },
            "reported": {
              "type": "string"
            }
          }
        },
        "iso": {
          "$ref": "#/$defs/sampledRange"
        },
        "exposureTimeNs": {
          "$ref": "#/$defs/sampledRange"
        },
        "whiteBalance": {
          "type": "object",
          "properties": {
            "mode": {
              "description": "AUTO, KELVIN or the CONTROL_AWB_MODE preset name.",
              "type": "string"
            },
            "kelvin": {
              "description": "The requested temperature of a KELVIN take.",
              "type": "integer"
            },
            "reportedCctStart": {
              "type": "integer"
            },
            "reportedCctEnd": {
              "type": "integer"
            },
            "tint": {
              "description": "The requested tint of a KELVIN take, otherwise the reported one.",
              "type": "integer"
            }
          }
        },
        "focus": {
          "type": "object",
          "properties": {
            "afMode": {
              "description": "The CONTROL_AF_MODE name, or its value when the name is unknown.",
              "type": "string"
            },
            "distanceDiopters": {
              "type": "number"
            }
          }
        },
        "zoom": {
          "$ref": "#/$defs/sampledRange"
        },
        "stabilization": {
          "type": "object",
          "properties": {
            "ois": {
              "description": "LENS_OPTICAL_STABILIZATION_MODE name.",
              "type": "string"
            },
            "eis": {
              "description": "CONTROL_VIDEO_STABILIZATION_MODE name.",
              "type": "string"
            }
          }
        },
        "processing": {
          "description": "NOISE_REDUCTION_MODE, EDGE_MODE and TONEMAP_MODE names.",
          "type": "object",
          "properties": {
            "noiseReduction": {
              "type": "string"
            },
            "edge": {
              "type": "string"
            },
            "toneMap": {
              "type": "string"
            }
          }
        }
      }
    },
    "knownValue": {
      "type": "object",
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unsupported",
            "known"
          ]
        },
        "value": {},
        "unit": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://opencinecam.org/schema/clip-sidecar.schema.json",
  "title": "Clip Sidecar",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordingId",
    "createdAt",
    "intent",
    "resolvedGraph",
    "events",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "recordingId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "intent": {
      "type": "object"
    },
    "resolvedGraph": {
      "type": "object",
      "properties": {
        "camera": {
          "description": "The camera settings sampled from the capture results while the take recorded. Optional; older sidecars omit it. Every key of the value is optional and left out when the camera did not report it.",
          "allOf": [
            {
              "$ref": "#/$defs/knownValue"
            }
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/cameraSettings"
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timeUs",
          "code",
          "severity"
        ]
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "media": {
      "type": "object"
    },
    "continuation": {
      "description": "Optional; present only on a take that continues on the phone a take whose USB drive was lost mid-take (OCC-PLAN-072 Delivery 4). The continuation is its own take with its own recordingId; this links it to the part on the drive, whose sidecar is not rewritten.",
      "type": "object",
      "required": [
        "of",
        "previousName",
        "index",
        "reason"
      ],
      "properties": {
        "of": {
          "description": "The recordingId (bundle id) of the take on the drive this one continues.",
          "type": "string",
          "format": "uuid"
        },
        "previousName": {
          "description": "The file name of that take's video on the drive.",
          "type": "string",
          "minLength": 1
        },
        "index": {
          "description": "1 for the first continuation of the original take.",
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "description": "Why the drive part stopped: the drive left (a volume event) or a write to it failed.",
          "enum": [
            "drive-disconnected",
            "drive-write-failed"
          ]
        }
      }
    },
    "motion": {
      "description": "Optional (schema 1.2.0); present only on a video take whose opt-in motion data was rendered. Older sidecars and takes without motion data omit it.",
      "type": "object",
      "required": [
        "sensors",
        "sync",
        "rateScale",
        "largestGyroGapUs",
        "camm",
        "log"
      ],
      "properties": {
        "sensors": {
          "type": "object",
          "required": [
            "gyroscope",
            "accelerometer",
            "magnetometer"
          ],
          "properties": {
            "gyroscope": {
              "$ref": "#/$defs/motionSensor"
            },
            "accelerometer": {
              "$ref": "#/$defs/motionSensor"
            },
            "magnetometer": {
              "$ref": "#/$defs/motionSensor"
            }
          }
        },
        "sync": {
          "description": "How the sensor samples were placed on the file's timeline: measured from the frames on the sensor clock, estimated because the camera clock is not the sensor clock, or estimated because the recorder's frame timing was not measured.",
          "enum": [
            "measured",
            "estimated-clock",
            "estimated-frames"
          ]
        },
        "rateScale": {
          "description": "Real (sensor) time per file time, the median over the take's frames: 1.0 for a real-time take, below 1 for slow motion played at the project rate.",
          "type": "number"
        },
        "largestGyroGapUs": {
          "description": "The largest interval between consecutive gyroscope samples, in microseconds of the sensor clock.",
          "type": "integer",
          "minimum": 0
        },
        "camm": {
          "description": "The CAMM metadata track appended to the MP4.",
          "type": "object",
          "required": [
            "present",
            "packets",
            "binUs"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "packets": {
              "type": "integer",
              "minimum": 0
            },
            "binUs": {
              "description": "The interval the CAMM series was resampled to; null when no series was built.",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "log": {
          "description": "The file name of the Gyroflow log (.gcsv) published beside the video; null when it was not attached.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
