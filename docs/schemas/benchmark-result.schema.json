{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "Advertised",
        "Candidate",
        "SessionCreated",
        "FirstFrameReceived",
        "Recorded",
        "FileVerified",
        "Sustained",
        "EmpiricallyVerified",
        "Failed",
        "Certified"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "observedAt"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "stale",
            "notRun"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "knownValue": {
      "type": "object",
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unsupported",
            "known"
          ]
        },
        "value": {},
        "unit": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://opencinecam.org/schema/benchmark-result.schema.json",
  "title": "Benchmark Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "benchmarkId",
    "createdAt",
    "destination",
    "bytesWritten",
    "windows",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "benchmarkId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "destination": {
      "type": "object"
    },
    "bytesWritten": {
      "type": "integer",
      "minimum": 0
    },
    "windows": {
      "type": "array"
    },
    "requiredBytesPerSecond": {
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "cancelled",
        "error"
      ]
    }
  },
  "additionalProperties": true
}
