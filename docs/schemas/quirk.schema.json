{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "Advertised",
        "Candidate",
        "SessionCreated",
        "FirstFrameReceived",
        "Recorded",
        "FileVerified",
        "Sustained",
        "EmpiricallyVerified",
        "Failed",
        "Certified"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "observedAt"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "stale",
            "notRun"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "knownValue": {
      "type": "object",
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unsupported",
            "known"
          ]
        },
        "value": {},
        "unit": {
          "type": "string"
        }
      }
    },
    "effectId": {
      "description": "Closed quirk effect vocabulary; an id this build does not know is ignored with a warning, never applied.",
      "type": "string",
      "enum": [
        "high-speed-prefer-physical-camera",
        "moto-high-speed-session-keys"
      ]
    }
  },
  "$id": "https://opencinecam.org/schema/quirk.schema.json",
  "title": "Quirk",
  "type": "object",
  "required": [
    "schemaVersion",
    "quirkId",
    "scope",
    "effect",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "quirkId": {
      "type": "string",
      "pattern": "^OCC-QUIRK-[0-9]{4}$"
    },
    "scope": {
      "type": "object",
      "required": [
        "device",
        "cameraId"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "cameraId": {
          "type": "string",
          "minLength": 1
        },
        "buildFingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/effectId"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "additionalProperties": true,
  "description": "A quirk record with its evidence. It is scoped to a device codename (Build.DEVICE) and a camera, never to a manufacturer. The build fingerprint is the build the evidence was gathered on; another running build keeps the quirk active with a warning."
}
